# Panda Breath Mod — environment variables
# Copy this file to .env and fill in the values for your setup.
# Portainer/Git stacks can set these as stack environment variables instead.
#
# ============================================================
# SETUP A: Panda Touch + Klipper/Moonraker  (standard)
#
#   docker compose up -d
# ============================================================

PANDA_IP=YOUR_PANDA_IP           # IP of the Panda Touch device
PANDA_SN=YOUR_PANDA_SERIAL       # Printer serial number
PANDA_ACCESS_CODE=YOUR_ACCESS_CODE
HA_TOKEN=YOUR_HA_LONG_LIVED_TOKEN

# ============================================================
# SETUP B: Elegoo Centauri Carbon 2 (no Panda Touch)
#
#   curl .../docker-compose.cc2.yml -o docker-compose.yml
#   docker compose up -d
#
# docker-compose.cc2.yml is a complete self-contained stack — no second file needed.
# Also requires LAN-only mode on the CC2:
#   Settings -> Network -> LAN Only Mode -> Enable
#
# Choose one sub-option below (A or B), then fill in the common vars beneath it.
# ============================================================

# --- Sub-option A: cc2_connector (NOT using elegoo-homeassistant) ---
# Use this if you do NOT have danielcherubini/elegoo-homeassistant installed.
# The cc2_connector container handles the direct connection to the CC2 printer.
#
# CC2_IP=YOUR_CC2_IP             # IP of the CC2 printer
# CC2_SN=YOUR_CC2_SERIAL         # CC2 serial number (Settings → About on the printer)
#
# MQTT broker — required so the panda backend can publish to Home Assistant.
# HA_MQTT_BROKER=YOUR_HA_IP      # IP or hostname of your HA MQTT broker (Mosquitto)
# HA_MQTT_PORT=1883
# HA_MQTT_USER=your_mqtt_username
# HA_MQTT_PASS=your_mqtt_password

# --- Sub-option B: elegoo-homeassistant integration ---
# Use this if you already have danielcherubini/elegoo-homeassistant installed.
# No cc2_connector container needed — Panda reads CC2 data via the HA REST API.
#
# CC2_HA_MODE=true
# HA_TOKEN=YOUR_HA_LONG_LIVED_TOKEN   # HA Profile → Long-Lived Access Tokens
# HA_BASE_URL=http://homeassistant:8123
#
# MQTT broker — still required so the panda backend can publish its own entities to HA.
# HA_MQTT_BROKER=YOUR_HA_IP
# HA_MQTT_PORT=1883
# HA_MQTT_USER=your_mqtt_username
# HA_MQTT_PASS=your_mqtt_password

# --- Common: no Panda Touch in CC2 mode ---
# Leave these dummy values as-is — the backend requires them but doesn't use them
# when CC2_IP or CC2_HA_MODE is set.
PANDA_SN=01P00A123456789
PANDA_ACCESS_CODE=01P00A12

# ============================================================
# OPTIONAL OVERRIDES (most users don't need these)
# ============================================================

# PANDA_HOST_IP=YOUR_DOCKER_HOST_LAN_IP   # auto-detected from PANDA_IP if unset
# PANDA_WEB_PORT=8088
# CC2_USER=elegoo
# CC2_PASS=123456
# HA_CC2_CHAMBER_ENTITY=sensor.your_cc2_chamber_temperature   # override auto-discovered entity
# HA_CC2_STATUS_ENTITY=sensor.your_cc2_print_status
# HA_CC2_PAUSE_ENTITY=button.your_cc2_pause
# HA_CC2_RESUME_ENTITY=button.your_cc2_resume
