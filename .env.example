# Optional overrides for local Docker Compose runs.
# Portainer/Git stacks can set these as stack environment variables instead.
#
# Compose defaults avoid env for stable internal addresses:
# - HA_MQTT_BROKER defaults to mosquitto
# - HA_BASE_URL defaults to http://homeassistant:8123
# - HA_MQTT_PORT defaults to 1883
# - CC2_USER/CC2_PASS default to elegoo/123456
# - topic prefixes default to panda_breath_mod and cc2
# - Panda web control publishes on host port 8088

# ---- Home Assistant / MQTT overrides ----
# HA_MQTT_BROKER=mosquitto
# HA_MQTT_PORT=1883
# HA_MQTT_USER=your_mqtt_username
# HA_MQTT_PASS=your_mqtt_password
# HA_BASE_URL=http://homeassistant:8123
# HA_TOKEN=your_ha_long_lived_token

# ---- Panda backend: still required for Panda binding ----
PANDA_IP=YOUR_PANDA_IP
PANDA_SN=YOUR_PANDA_SERIAL
PANDA_ACCESS_CODE=YOUR_ACCESS_CODE
# PANDA_HOST_IP is auto-detected from PANDA_IP when possible.
# Set it only if the Panda cannot reach the advertised address.
# PANDA_HOST_IP=YOUR_DOCKER_HOST_LAN_IP

# ---- CC2 backend overrides ----
CC2_IP=YOUR_CC2_IP
CC2_SN=YOUR_CC2_SERIAL

# ---- Web control override ----
# PANDA_WEB_PORT=8088
