# Home Assistant MQTT broker (Mosquitto add-on)
HA_MQTT_BROKER=YOUR_HA_IP
HA_MQTT_PORT=1883
HA_MQTT_USER=your_mqtt_username
HA_MQTT_PASS=your_mqtt_password

# ---- Panda backend (Panda.py reads panda_config.json directly) ----
# Edit panda_config.json with your Panda printer IP, SN, access code,
# HA base URL, and HA long-lived token. See panda_config.json for fields.

# ---- CC2 backend ----
CC2_IP=YOUR_CC2_IP
CC2_USER=elegoo
CC2_PASS=123456
CC2_SN=YOUR_SERIAL_NUMBER
CC2_TOPIC_PREFIX=cc2
