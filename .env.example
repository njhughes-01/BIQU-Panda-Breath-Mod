# Home Assistant MQTT broker (Mosquitto add-on)
HA_MQTT_BROKER=YOUR_HA_IP
HA_MQTT_PORT=1883
HA_MQTT_USER=your_mqtt_username
HA_MQTT_PASS=your_mqtt_password

# ---- Panda backend ----
PANDA_IP=YOUR_PANDA_IP
PANDA_SN=YOUR_PANDA_SERIAL
PANDA_ACCESS_CODE=YOUR_ACCESS_CODE
PANDA_HOST_IP=YOUR_DOCKER_HOST_IP
HA_BASE_URL=http://YOUR_HA_IP:8123
HA_TOKEN=YOUR_HA_LONG_LIVED_TOKEN
PANDA_MQTT_TOPIC_PREFIX=panda_breath_mod

# ---- CC2 backend (optional — only needed with --profile cc2) ----
CC2_IP=YOUR_CC2_IP
CC2_USER=elegoo
CC2_PASS=123456
CC2_SN=YOUR_CC2_SERIAL
CC2_TOPIC_PREFIX=cc2
