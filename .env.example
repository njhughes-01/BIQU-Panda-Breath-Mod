# Environment variable reference for Panda Breath Mod Docker stack.
# Copy this file to .env and fill in the required values.
# Portainer/Git stacks can set these as stack environment variables instead.

# ---- Required: Panda device credentials ----
PANDA_IP=YOUR_PANDA_IP
PANDA_SN=YOUR_PANDA_SERIAL
PANDA_ACCESS_CODE=YOUR_ACCESS_CODE

# ---- Required: Home Assistant ----
HA_TOKEN=your_ha_long_lived_token

# ---- Optional overrides: Home Assistant / MQTT ----
# Compose defaults work when HA and Mosquitto run in the same Docker stack.
# Override only if they are on a different host.
# HA_MQTT_BROKER=mosquitto
# HA_MQTT_PORT=1883
# HA_MQTT_USER=your_mqtt_username
# HA_MQTT_PASS=your_mqtt_password
# HA_BASE_URL=http://homeassistant:8123

# ---- Optional: Panda host IP ----
# Auto-detected from PANDA_IP when possible.
# Set only if the Panda device cannot reach the auto-detected address.
# PANDA_HOST_IP=YOUR_DOCKER_HOST_LAN_IP

# ---- Optional: web control port ----
# PANDA_WEB_PORT=8088

# ---- Optional: Elegoo Centauri Carbon 2 ----
# Only needed when running with docker-compose.cc2.yml.
# Requires LAN-only mode enabled on the CC2 printer:
#   Settings -> Network -> LAN Only Mode -> Enable
# CC2_IP=YOUR_CC2_IP
# CC2_SN=YOUR_CC2_SERIAL
# CC2_USER=elegoo
# CC2_PASS=123456
# CC2_TOPIC_PREFIX=cc2
